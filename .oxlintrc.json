{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"unicorn/prefer-array-flat-map": "error"
	},
	"ignorePatterns": [
		"node_modules/**",
		"dist/**",
		"data/**",
		"bench/fixtures/eumenes/**"
	]
}
