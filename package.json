{
	"name": "eumenes_router",
	"version": "0.0.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"packageManager": "bun@1.4.4",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./sqlite": {
			"types": "./dist/sqlite.d.ts",
			"default": "./dist/sqlite.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"best-v1": "bash bench/router/experiments/best/run.sh",
		"best-v2": "${BEST_PYTHON:-/tmp/cvenv/bin/python} bench/router/experiments/best/best_v2.py",
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "bun run build",
		"lint": "oxlint --deny-warnings",
		"lint:fix": "oxlint --deny-warnings --fix",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"bench:score": "bun bench/score.ts",
		"router": "bun bench/router/main.ts"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/node": "25.9.3",
		"oxfmt": "0.71.0",
		"oxlint": "1.86.0",
		"typescript": "5.9.3"
	}
}
